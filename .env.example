# ─── Deployer ─────────────────────────────────────────────────────────────────
# Full 32-byte hex with 0x prefix (66 chars). Must hold AVAX on the target network.
# Mainnet deploys spend real money — keep this key separate from any treasury key.
DEPLOYER_PRIVATE_KEY=

# ─── Hunt / Season ────────────────────────────────────────────────────────────
# Unix timestamp (seconds) the 64-day season opens. Leave blank or set 0 to
# start at the moment of deployment. This is immutable once deployed.
SEASON_START=

# Metadata bases. Trailing slash required.
INGREDIENT_NFT_URI=
POTION_NFT_BASE_URI=

# ─── Predictions Market ───────────────────────────────────────────────────────
# Protocol fee in basis points, taken from the losing pool at resolution.
# 300 = 3%. Hard-capped at 1000 (10%) by the contract.
RAKE_BPS=300

# Where rake accumulates. Should NOT be the deployer key.
TREASURY_ADDRESS=

# Who may resolve markets until the real oracle exists. A multisig is strongly
# preferred over a hot key — this address decides who wins every market.
RESOLVER_ADDRESS=

# ─── Settlement token ─────────────────────────────────────────────────────────
# Native USDC on Avalanche C-Chain, for markets settled in USDC rather than AVAX.
# Mainnet: 0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
USDC_ADDRESS=
